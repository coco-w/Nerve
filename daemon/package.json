{
  "name": "nerve-daemon",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "bin": {
    "nerve": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "npm run build && node scripts/package.mjs",
    "start": "node dist/cli.js start --foreground",
    "gateway": "node dist/gateway/cli.js",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "werift": "0.28.0",
    "ws": "8.23.0"
  }
}
